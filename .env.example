# ====================================================
# PHARMACY SYSTEM — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to Git.
# ====================================================

# ----- Spring Boot Backend -----
# MongoDB Atlas connection string (REQUIRED)
# Get from: Atlas UI → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.<host>.mongodb.net/

# MongoDB database name (optional — defaults to pharmacy_db)
MONGODB_DATABASE=pharmacy_db

# Spring Boot server port (optional — defaults to 8080)
PORT=8080

# URL of the Python ML service (optional — defaults to localhost:5001)
ML_SERVICE_URL=http://localhost:5001/api/predictions

# ----- Python ML Module -----
# Same MongoDB URI used by the Spring Boot backend
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.<host>.mongodb.net/
# MONGODB_DATABASE=pharmacy_db

# ML service port (optional — defaults to 5001)
# PORT=5001

# ----- React Frontend -----
# Base URL of the Spring Boot REST API
VITE_API_URL=http://localhost:8080

# Initial Administrator Bootstrap (optional)
# ADMIN_BOOTSTRAP_ID=EMP-001
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_EMAIL=admin@pharmacare.com
